JPAI_HOST=127.0.0.1
JPAI_PORT=8000
JPAI_LOG_LEVEL=INFO
JPAI_OLLAMA_BASE_URL=http://127.0.0.1:11434
JPAI_MODEL_TIMEOUT_SECONDS=90
JPAI_DATABASE_PATH=data/jpai.sqlite3
JPAI_GATEWAY_REQUESTS_PER_MINUTE=60
JPAI_GATEWAY_MAX_REQUEST_BYTES=1048576
# Set a long random value before exposing the API beyond loopback.
JPAI_GATEWAY_API_KEY=

# Optional GPT-6 cloud model fabric; backend-only secret.
JPAI_OPENAI_API_KEY=
JPAI_OPENAI_BASE_URL=https://api.openai.com/v1
JPAI_MODEL_FABRIC_TIMEOUT_SECONDS=180
JPAI_MODEL_FABRIC_MAX_CONCURRENCY=8
